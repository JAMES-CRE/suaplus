# Copy to .env locally or set these values in the deployment secret store.
# Never commit real credentials.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
SITE_URL=http://127.0.0.1:8000

# PostgreSQL
DB_NAME=suaplus
DB_USER=suaplus_dev
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Background jobs
REDIS_URL=redis://localhost:6379/0

# Google Workspace OAuth. Configure the OAuth consent screen for KNUST
# domains and provide the real client values when UITS supplies them.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# SMTP relay. Leave SMTP_HOST empty to use Django's local console backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Sua+ <noreply@knust.edu.gh>

# Optional external providers. Leave blank until credentials and policy are approved.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
GEMINI_API_KEY=
HR_SYNC_URL=
HR_SYNC_KEY=
