# Copy to .env.deploy, keep it untracked, and fill secrets locally.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=https://replace-with-approved-staging-host
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
TRUST_PROXY_TLS=false
DB_NAME=suaplus
DB_USER=suaplus
DB_PASSWORD=
DB_HOST=database
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
WORKER_HEARTBEAT_REQUIRED=true
WEB_BIND=127.0.0.1
WEB_PORT=8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
HR_SYNC_URL=
HR_SYNC_KEY=
BADGE_PRIVATE_KEY_FILE=
BADGE_PUBLIC_KEY_FILE=
BADGE_KEY_ID=current
BACKUP_RETENTION_DAYS=30
